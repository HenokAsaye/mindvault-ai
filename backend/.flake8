[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .eggs,
    *.egg-info,
    build,
    dist,
    app/adapters/outbound/db/migrations/versions
per-file-ignores =
    __init__.py:F401
max-complexity = 15
count = True
statistics = True
